# Copy to .env.local (or run `npm run env:local` with the local Supabase stack running).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# invite (pilot) | open — open also needs Supabase sign-ups enabled
AUTH_SIGNUP_MODE=invite
# Never set a Supabase secret/service-role key here: the app does not use one.

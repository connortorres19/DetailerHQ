{
  "name": "detailerhq",
  "version": "0.0.0",
  "private": true,
  "description": "DetailerHQ (working name) — marketing website and database foundation",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "env:local": "node scripts/write-env-local.mjs",
    "invite": "node scripts/invite-owner.mjs",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:node": "node --test --test-concurrency=1 'tests/node/*.test.js'",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test 'tests/unit/*.test.ts'",
    "test:e2e": "playwright test",
    "test": "npm run db:reset && npm run test:db && npm run test:node"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pg": "8.23.1",
    "supabase": "2.122.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "gsap": "3.15.0",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
